# ==============================================================================
# QUANTEDGE AI — CONFIGURACIÓN DE ENTORNO
# ⚠️ Rellena las claves vacías antes de ejecutar
# ==============================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=
# ==============================================================================
# CONFIGURACIÓN METATRADER 5 (IC MARKETS DEMO)
# ==============================================================================
MT5_ACCOUNT=52974519
MT5_PASSWORD=
MT5_SERVER="ICMarketsSC-Demo"

# ==============================================================================
# NOTIFICACIONES TELEGRAM
# ==============================================================================
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=6225167403
TELEGRAM_ENABLED=true

# ------------------------------------------------------------------------------
# CONFIGURACIÓN GENERAL DEL PIPELINE
# ------------------------------------------------------------------------------
# 🔧 Análisis por activo
ANALYSIS_MIN_TRADES=5

# 🔧 Cooldowns
FAILED_ORDER_COOLDOWN_SEC=300
MARKET_CLOSED_COOLDOWN_SEC=1800

# 🔧 Hora del reporte
DAILY_REPORT_HOUR=23
DAILY_REPORT_MINUTE=59

# 🔧 Activos:
TRADING_SYMBOLS=XAUUSD,XTIUSD,XBRUSD,XAGUSD,BTCUSD,ETHUSD,SOLUSD,US500

DECISION_THROTTLE_SECONDS=1.0
HEARTBEAT_INTERVAL_SECONDS=900.0

# ------------------------------------------------------------------------------
# GESTIÓN DE RIESGO INSTITUCIONAL (RiskGuardian)
# ------------------------------------------------------------------------------

# ==============================================================================
# FALLBACK DE CAPITAL (solo se usa si MT5 no está disponible)
# El capital real se lee SIEMPRE desde MT5 en vivo.
# NO MODIFICAR este valor manualmente: es solo un fallback de seguridad.
# ==============================================================================
CAPITAL_BASE_USD=1740.00

# ─── Riesgo ────────────────────────────────────────────────────────────────
MAX_RISK_PER_TRADE_PCT=0.5
GOLD_MAX_RISK_PCT=0.3
CRYPTO_MAX_RISK_PCT=0.5
DAILY_DRAWDOWN_LIMIT_PCT=3.0
MAX_CONCURRENT_POSITIONS=3
MAX_DAILY_TRADES=20
COOLDOWN_SECONDS=60
STOP_LOSS_CUARENTENA_SECONDS=300

# ─── Spread ────────────────────────────────────────────────────────────────
MAX_ALLOWED_SPREAD_BPS=15.0
CRYPTO_OFFHOURS_MAX_SPREAD_BPS=20.0

# ─── Sizing por clase (topes de lotes) ─────────────────────────────────────
CRUDE_MAX_LOT_SIZE=0.50
GOLD_MAX_LOT_SIZE=0.02
XAG_MAX_LOT_SIZE=0.05
CRYPTO_MAX_LOT_SIZE=0.10
US500_MAX_LOT_SIZE=0.50
FOREX_MAX_LOT_SIZE=0.10

# ─── Señales ───────────────────────────────────────────────────────────────
MIN_CONFIDENCE_THRESHOLD=90.0

# ─── Multiplicadores ATR por clase ─────────────────────────────────────────
GOLD_ATR_STOP_MULTIPLIER=4.5
GOLD_ATR_PROFIT_MULTIPLIER=7.0
XAG_ATR_STOP_MULTIPLIER=2.5
XAG_ATR_PROFIT_MULTIPLIER=4.0
OIL_ATR_STOP_MULTIPLIER=1.8
OIL_ATR_PROFIT_MULTIPLIER=3.0
US500_ATR_STOP_MULTIPLIER=2.0
US500_ATR_PROFIT_MULTIPLIER=3.5
FOREX_ATR_STOP_MULTIPLIER=1.2
FOREX_ATR_PROFIT_MULTIPLIER=2.0
CRYPTO_ATR_STOP_MULTIPLIER=2.2
CRYPTO_ATR_PROFIT_MULTIPLIER=3.8
ATR_STOP_MULTIPLIER=1.8
ATR_PROFIT_MULTIPLIER=3.0

# ─── RSI ───────────────────────────────────────────────────────────────────
RSI_BUY_MIN_GENERAL=50.0
RSI_BUY_MAX_GENERAL=72.0
RSI_SELL_MIN_GENERAL=34.0
RSI_SELL_MAX_GENERAL=50.0
RSI_BUY_MIN_OIL=45.0
RSI_BUY_MAX_OIL=72.0
RSI_SELL_MIN_OIL=28.0
RSI_SELL_MAX_OIL=55.0

# ------------------------------------------------------------------------------
# MÓDULO DE EJECUCIÓN OMS Y BLINDAJE DE CAPITAL (ExecutionOMS)
# ------------------------------------------------------------------------------
BREAK_EVEN_ATR_TRIGGER=1.2
BREAK_EVEN_LOCK_ATR=0.10

TRAILING_STOP_ATR_TRIGGER=2.0
TRAILING_STOP_ATR_DISTANCE=1.8

MAGIC_NUMBER=992026